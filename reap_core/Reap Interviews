function getGCD(a: number, b: number): number {
  while (b !== 0) {
    let temp = b;
    b = a % b;
    a = temp;
  }
  return a;
}

// THE UNIT TESTS
describe("getGCD Tests", () => {
  test("GCD of 12 and 8 should be 4", () => {
    expect(getGCD(12, 8)).toBe(4); // Passes
  });

  test("GCD of 20 and 15 should be 5", () => {
    expect(getGCD(20, 15)).toBe(5); // Passes
  });

  // ⚠️ THE HIDDEN TRICK TEST CASE
  test("GCD of 35 and 14 should be 14", () => {
    expect(getGCD(35, 14)).toBe(14); // FAILS! Returns 7.
  });
});

